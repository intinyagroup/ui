{
  "name": "@intinyagroup/editor-core",
  "version": "0.1.1-alpha.10",
  "description": "Visual editor engine for Intinya UI - drag-drop, canvas, state management",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "module": "./dist/index.js"
    },
    "./dnd": {
      "types": "./dist/dnd/index.d.ts",
      "svelte": "./dist/dnd/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "svelte": "./dist/canvas/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "default": "./dist/export/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "svelte-package -o dist -w"
  },
  "dependencies": {
    "@intinyagroup/ui": "workspace:*",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "clsx": "^2.1.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
