{
  "name": "@intinyagroup/react-data-table",
  "version": "0.1.1-alpha.8",
  "description": "Enterprise React data table component powered by TanStack Table Core and @intinyagroup/tokens",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.1",
    "@intinyagroup/grid-core": "workspace:*",
    "@intinyagroup/react": "workspace:*",
    "@intinyagroup/tokens": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intinyagroup/ui.git",
    "directory": "packages/react-data-table"
  },
  "publishConfig": {
    "access": "public"
  }
}
