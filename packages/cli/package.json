{
  "name": "@intinyagroup/cli",
  "version": "0.1.1-alpha.3",
  "description": "CLI to add Intinya UI components to your Svelte project",
  "type": "module",
  "bin": {
    "intinya": "./dist/index.js"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "generate:registry": "node scripts/generate-registry.mjs"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "magic-string": "^0.30.17",
    "prompts": "^2.4.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^6.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intinyagroup/ui.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
