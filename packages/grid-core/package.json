{
  "name": "@intinyagroup/grid-core",
  "version": "0.1.1-alpha.1",
  "description": "Shared grid infrastructure (TanStack Table + Virtual + keyboard + clipboard)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "module": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist",
    "check": "echo 'no check'",
    "dev": "svelte-package -o dist -w"
  },
  "dependencies": {
    "@intinyagroup/ui": "workspace:*",
    "@tanstack/table-core": "^8.21.3",
    "@tanstack/svelte-virtual": "^3.13.35",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.55.2",
    "typescript": "^6.0.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intinyagroup/ui.git",
    "directory": "packages/grid-core"
  },
  "publishConfig": {
    "access": "public"
  }
}
