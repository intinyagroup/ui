{
  "name": "@intinyagroup/md3",
  "version": "0.1.1-alpha.6",
  "description": "Material Design 3 components for Intinya UI",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "module": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "svelte-package -o dist -w"
  },
  "dependencies": {
    "@intinyagroup/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
