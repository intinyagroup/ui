{
  "name": "@intinyagroup/notion-database",
  "version": "0.1.1-alpha.11",
  "description": "Notion-style multi-view database component (Table, Board, Calendar, Gallery) for Svelte 5",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist",
    "check": "echo 'no check'",
    "dev": "svelte-package -o dist -w"
  },
  "dependencies": {
    "@intinyagroup/ui": "workspace:*",
    "@intinyagroup/data-table": "workspace:*",
    "@intinyagroup/kanban": "workspace:*",
    "@intinyagroup/calendar": "workspace:*",
    "@intinyagroup/grid-core": "workspace:*",
    "@intinyagroup/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.55.2",
    "typescript": "^6.0.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intinyagroup/ui.git",
    "directory": "packages/notion-database"
