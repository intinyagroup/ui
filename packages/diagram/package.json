    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
