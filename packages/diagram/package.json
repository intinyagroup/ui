{
  "name": "@intinyagroup/diagram",
  "version": "0.1.0",
  "description": "Reusable Svelte node-graph and workflow canvas primitives",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
