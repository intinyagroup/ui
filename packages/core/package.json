{
  "name": "@intinyagroup/ui",
  "version": "0.1.1-alpha.6",
  "description": "Shared UI component library for intinyagroup projects",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist && find dist -name \"*.test.*\" -delete && find dist -name \"*Test.svelte*\" ! -name \"Testimonial*\" -delete && find dist -name \"*Test.svelte*\" ! -name \"Testimonial*\" -delete",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "svelte-package -o dist -w",
    "test": "vitest run"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.1",
    "@intinyagroup/tokens": "workspace:*",
    "@lucide/svelte": "^1.28.0",
    "@tanstack/svelte-virtual": "^3.13.35",
    "@tanstack/table-core": "^8.21.3",
    "bits-ui": "^1.8.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "formsnap": "^2.0.1",
    "jsbarcode": "^3.12.3",
    "lucide-svelte": "^1.0.1",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "sveltekit-superforms": "^2.30.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.24.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intinyagroup/ui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
