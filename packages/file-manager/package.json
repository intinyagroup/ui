{
  "name": "@intinyagroup/file-manager",
  "version": "0.1.0",
  "description": "Enterprise File Manager component with folder tree, breadcrumbs, grid/list view, upload, and file operations",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist",
