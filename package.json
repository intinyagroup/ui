{
  "name": "intinyagroup-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @intinyagroup/ui component library",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @intinyagroup/storybook storybook",
    "build": "pnpm --filter @intinyagroup/tokens build && pnpm --filter @intinyagroup/ui build",
    "build:tokens": "turbo run build --filter=@intinyagroup/tokens",
    "build:core": "turbo run build --filter=@intinyagroup/ui",
    "storybook": "pnpm --filter @intinyagroup/storybook storybook",
    "build-storybook": "pnpm --filter @intinyagroup/storybook build-storybook",
    "check": "turbo run check --continue",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "build:all": "turbo run build",
    "changeset": "changeset",
    "publish": "changeset publish",
    "stage:apply": "npm stage apply",
    "cli": "pnpm --filter @intinyagroup/cli build",
    "generate:registry": "pnpm --filter @intinyagroup/cli generate:registry",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "build:react": "turbo run build --filter=@intinyagroup/react"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.5.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "vite",
        "esbuild"
      ],
      "allowAny": [
        "vite",
        "esbuild"
      ]
    }
  },
  "lint-staged": {
    "*.{js,ts,json,css,md}": "prettier --write",
    "*.svelte": "prettier --plugin prettier-plugin-svelte --write"
  },
  "packageManager": "pnpm@10.33.2"
}
