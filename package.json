{
  "name": "intinyagroup-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @intinyagroup/ui component library",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @intinyagroup/storybook storybook",
    "build": "pnpm --filter @intinyagroup/tokens build && pnpm --filter @intinyagroup/ui build",
    "build:tokens": "pnpm --filter @intinyagroup/tokens build",
    "build:core": "pnpm --filter @intinyagroup/ui build",
    "storybook": "pnpm --filter @intinyagroup/storybook storybook",
    "build-storybook": "pnpm --filter @intinyagroup/storybook build-storybook",
    "check": "pnpm -r run check",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "build:all": "pnpm -r run build",
    "changeset": "changeset",
    "publish": "changeset publish",
    "stage:apply": "npm stage apply",
    "cli": "pnpm --filter @intinyagroup/cli build",
    "generate:registry": "pnpm --filter @intinyagroup/cli generate:registry",
    "prepare": "pnpm --filter @intinyagroup/docs exec svelte-kit sync && mkdir -p .svelte-kit && cp packages/docs/.svelte-kit/tsconfig.json .svelte-kit/",
    "test": "pnpm --filter @intinyagroup/ui test",
    "build:react": "pnpm --filter @intinyagroup/react build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.5.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0"
  }
}
