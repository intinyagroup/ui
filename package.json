{
  "name": "@intinyagroup/ui",
  "version": "0.1.0",
  "description": "Shared UI component library for intinyagroup projects",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./tokens": {
      "css": "./dist/tokens/base.css"
    },
    "./tokens/*": {
      "css": "./dist/tokens/*"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.28.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/svelte": "^8.6.14",
    "@storybook/sveltekit": "^8.6.14",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.0.0",
    "bits-ui": "^2.17.3",
    "clsx": "^2.1.1",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.14",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "svelte-loader": "^3.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^6.4.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intinyagroup/ui.git"
  },
  "bugs": {
    "url": "https://github.com/intinyagroup/ui/issues"
  },
  "homepage": "https://github.com/intinyagroup/ui#readme"
}
